# Copy to backend/.env and fill in. The app will not start without SECRET_KEY.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./writathon.db
FRONTEND_URL=http://localhost:5173

# First admin account, created on startup if no admin exists
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shared secret the payment gateway signs webhooks with (X-Webhook-Signature header)
PAYMENT_WEBHOOK_SECRET=

# Local demos only: seeds demo users/leads (admin@writathon.com / admin123 ...) and enables mock checkout
DEMO_MODE=false

# Browser origins allowed to call the API (comma-separated). Add your deployed frontend URL, e.g. https://your-site.netlify.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Outgoing email. Leave SMTP_HOST empty in development: emails are then logged as PENDING and not delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Per-IP requests/minute on login, registration, tracking-ID lookup and story upload
RATE_LIMIT_PER_MINUTE=20
