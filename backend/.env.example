# Copy to backend/.env and fill in. The app will not start without SECRET_KEY.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./writathon.db
FRONTEND_URL=http://localhost:5173

# First admin account, created on startup if no admin exists
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shared secret the payment gateway signs webhooks with (X-Webhook-Signature header)
PAYMENT_WEBHOOK_SECRET=

# Local demos only: seeds demo users/leads (admin@writathon.com / admin123 ...) and enables mock checkout
DEMO_MODE=false
